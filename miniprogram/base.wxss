/* 由 scripts/build-wxss.js 从 frontend/src/styles/app.css 自动生成，勿手改 */
/* 375 设计稿：1px → 2rpx */

/* ==========================================================================
   医院智能导诊 · 视觉基线
   配色与版式直接对齐墨刀原型（--brand 青绿 / --accent 橙 / --ink 深墨）
   ========================================================================== */

page {
  --paper: #e9f0f1;
  --screen: #f4f7f7;
  --card: #ffffff;
  --ink: #0e2a31;
  --ink2: #42606a;
  --muted: #8ca2aa;
  --brand: #0ea5a5;
  --brand-deep: #05787f;
  --brand-soft: #e5f7f6;
  --accent: #ff8557;
  --accent-soft: #fff0e9;
  --line: #e8eff0;
  --danger: #e24c4c;
  --danger-soft: #fdeceb;
  --shadow: 0 24rpx 60rpx -28rpx rgba(9, 52, 62, 0.22);
  --shadow-sm: 0 12rpx 36rpx -24rpx rgba(9, 52, 62, 0.28);
}
view, text, image, input, button, scroll-view, textarea {
  box-sizing: border-box;

}

html,
body,
#root {
  margin: 0;
  height: 100%;
}

body {
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Hiragino Sans GB", "Microsoft YaHei",
    system-ui, sans-serif;
  background: radial-gradient(2400rpx 1200rpx at 12% -10%, #f7fbfb 0%, rgba(247, 251, 251, 0) 60%),
    radial-gradient(1800rpx 1000rpx at 100% 0%, #e4f2f1 0%, rgba(228, 242, 241, 0) 55%), var(--paper);
  color: var(--ink);

}

/* ---------- 外壳 ---------- */

/* 状态栏 */
.status {
  height: 88rpx;
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 44rpx 0 52rpx;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ink);
}

.status .icons {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status svg {
  display: block;
}

/* 小程序胶囊 */

/* 导航 */
.nav {
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  padding: 0 216rpx 0 32rpx;
  position: relative;
}

.nav .back {
  width: 56rpx;
  height: 56rpx;
  display: grid;
  place-items: center;
  margin-right: 12rpx;
  border-radius: 50%;

  transition: background 0.18s;
  border: 0;
  background: transparent;
  color: var(--ink);
}

.nav h1 {
  font-size: 33rpx;
  font-weight: 600;
  margin: 0;
  letter-spacing: 0.01em;
  white-space: nowrap;
}

.nav .st {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  padding: 4rpx 16rpx 4rpx 12rpx;
  border-radius: 198rpx;
  font-weight: 500;
}

.nav .st i {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #12c08a;
  box-shadow: 0 0 0 6rpx rgba(18, 192, 138, 0.16);
}

/* 滚动区 */
.content {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 32rpx 48rpx;

}


/* ---------- 欢迎卡 ---------- */
.welcome {
  position: relative;
  background: var(--card);
  border-radius: 44rpx;
  padding: 32rpx 32rpx 0;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.welcome::before {
  content: "";
  position: absolute;
  inset: -40% -30% auto auto;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 40%, rgba(14, 165, 165, 0.16), rgba(14, 165, 165, 0) 70%);
}

.w-glow {
  position: absolute;
  right: -52rpx;
  bottom: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(255, 133, 87, 0.14), rgba(255, 133, 87, 0) 68%);
}

.w-top {
  display: flex;
  gap: 24rpx;
  align-items: center;
  position: relative;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #19bdb4, #07818e);
  display: grid;
  place-items: center;
  position: relative;
  box-shadow: 0 20rpx 40rpx -24rpx rgba(6, 120, 127, 0.9);
}

.avatar span {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.avatar::after {
  content: "";
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #12c08a;
  border: 5rpx solid #fff;
}

.w-name {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.w-name h2 {
  margin: 0;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.tag {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 500;
}

.w-desc {
  margin: 6rpx 0 0;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.45;
  padding-right: 8rpx;
}

.ecg {
  display: block;
  width: calc(100% + 64rpx);
  margin: 24rpx -32rpx 0;
  height: 52rpx;
  opacity: 0.9;
}

.ecg path {
  stroke: var(--brand);
  fill: none;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 520;
  stroke-dashoffset: 520;
  animation: draw 2.6s 0.25s ease forwards;
}

@keyframes draw {
  to {
    stroke-dashoffset: 0;
  }
}

.entries {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4rpx;
  margin: 24rpx -12rpx 0;
  padding: 16rpx 8rpx 28rpx;
  position: relative;
}

.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 4rpx;
  border-radius: 28rpx;

  transition: 0.18s;
  background: transparent;
  border: 0;
  font-family: inherit;
}

.entry i {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  display: grid;
  place-items: center;
  background: #f2f8f8;
}

.entry i svg {
  width: 34rpx;
  height: 34rpx;
  stroke: var(--brand-deep);
  fill: none;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.entry b {
  font-size: 23rpx;
  font-weight: 500;
  color: var(--ink2);
}

.entry:nth-child(3) i {
  background: var(--accent-soft);
}

.entry:nth-child(3) i svg {
  stroke: #e3703f;
}

/* ---------- 对话 ---------- */
.day {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin: 36rpx 0 28rpx;
  letter-spacing: 0.04em;
}

.row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
  animation: fadeUp 0.32s ease both;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.row.me {
  flex-direction: row-reverse;
}

.mini-av {
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 22rpx;
  background: linear-gradient(150deg, #19bdb4, #07818e);
  display: grid;
  place-items: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx -18rpx rgba(6, 120, 127, 0.9);
}

.bubble {
  max-width: 524rpx;
  background: #fff;
  border-radius: 32rpx 32rpx 32rpx 12rpx;
  padding: 22rpx 26rpx;
  box-shadow: var(--shadow-sm);
  font-size: 27rpx;
  line-height: 1.62;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble em {
  font-style: normal;
  color: var(--brand-deep);
  font-weight: 600;
}

.row.me .bubble {
  border-radius: 32rpx 32rpx 12rpx 32rpx;
  background: linear-gradient(145deg, #17b7ae, #0c8e98);
  color: #fff;
  box-shadow: 0 24rpx 44rpx -32rpx rgba(8, 120, 130, 0.9);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.chip {
  border: 2rpx solid var(--line);
  background: #fff;
  border-radius: 198rpx;
  font-family: inherit;
  font-size: 24rpx;
  color: var(--brand-deep);
  padding: 12rpx 22rpx;

  transition: 0.16s;
}

/* 文件气泡 */
.file-bubble {
  display: flex;
  align-items: center;
  gap: 18rpx;
  max-width: 480rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 18rpx 22rpx;
  box-shadow: var(--shadow-sm);
  font-size: 24rpx;
  color: var(--ink2);
}

.file-bubble .ficon {
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  display: grid;
  place-items: center;
  font-size: 26rpx;
  color: var(--brand-deep);
}

.file-bubble .fmeta {
  min-width: 0;
}

.file-bubble .fname {
  font-size: 24rpx;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 340rpx;
}

.file-bubble .fstat {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 加载态 */
.typing {
  display: flex;
  gap: 8rpx;
  padding: 28rpx 32rpx;
}

.typing i {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b6ccd0;
  animation: bounce 1.2s infinite;
}

.typing i:nth-child(2) {
  animation-delay: 0.15s;
}

.typing i:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes bounce {
  0%,
  60%,
  100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.caret {
  display: inline-block;
  width: 4rpx;
  height: 26rpx;
  background: var(--brand);
  vertical-align: -4rpx;
  margin-left: 4rpx;
  animation: blink 1s steps(2) infinite;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

/* ---------- 智能分析卡 ---------- */
.analysis {
  margin-left: 78rpx;
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
  position: relative;
  animation: fadeUp 0.34s ease both;
}

.an-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx 0;
}

.an-head .spark {
  width: 32rpx;
  height: 32rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  display: grid;
  place-items: center;
}

.an-head .spark svg {
  width: 20rpx;
  height: 20rpx;
  stroke: var(--brand-deep);
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
}

.an-head b {
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.an-head .ok {
  margin-left: auto;
  font-size: 21rpx;
  color: #12a06f;
  background: #e8f8f1;
  padding: 4rpx 14rpx;
  border-radius: 198rpx;
}

.an-list {
  padding: 20rpx 28rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.an-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.an-item .nm {
  font-size: 26rpx;
  font-weight: 500;
  width: 200rpx;
  flex: 0 0 200rpx;
}

.an-item .nm small {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  font-weight: 400;
  margin-top: 2rpx;
}

.meter {
  flex: 1;
  height: 12rpx;
  border-radius: 198rpx;
  background: #eef4f4;
  overflow: hidden;
}

.meter i {
  display: block;
  height: 100%;
  border-radius: 198rpx;
  background: linear-gradient(90deg, #1cc2b4, #0a8b9b);
  width: 0;
  transition: width 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.an-item.second .meter i {
  background: linear-gradient(90deg, #9fd9d2, #6dbfc4);
}

.an-item .pct {
  font-size: 23rpx;
  color: var(--brand-deep);
  font-variant-numeric: tabular-nums;
  width: 64rpx;
  text-align: right;
  font-weight: 600;
}

.an-note {
  margin: 16rpx 28rpx 0;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink2);
  background: #f6fafa;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.an-note b {
  color: var(--accent);
  font-weight: 600;
}

.an-btns {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx 28rpx;
}

.btn {
  flex: 1;
  border: 0;
  border-radius: 24rpx;
  padding: 20rpx 0;
  font-family: inherit;
  font-size: 26rpx;
  font-weight: 600;

  transition: 0.18s;
  letter-spacing: 0.01em;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.15;
}

.btn.primary {
  background: linear-gradient(135deg, #17bbb0, #07818f);
  color: #fff;
  box-shadow: 0 20rpx 40rpx -28rpx rgba(7, 129, 143, 1);
}

.btn.ghost {
  background: #f3f8f8;
  color: var(--ink2);
  flex: 0 0 192rpx;
  font-weight: 500;
}

/* ---------- 急症卡 ---------- */
.emg-card {
  margin-left: 78rpx;
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 28rpx 64rpx -36rpx rgba(190, 46, 46, 0.55);
  border: 2rpx solid #f7d9d7;
  overflow: hidden;
  animation: fadeUp 0.34s ease both;
}

.emg-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx 20rpx;
  background: linear-gradient(135deg, #fff4f3, #fff);
}

.emg-head .dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--danger);
  display: grid;
  place-items: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  animation: pulse 1.6s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(226, 76, 76, 0.45);
  }
  70% {
    box-shadow: 0 0 0 20rpx rgba(226, 76, 76, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(226, 76, 76, 0);
  }
}

.emg-head b {
  font-size: 27rpx;
  color: #b3312f;
}

.emg-body {
  padding: 4rpx 28rpx 8rpx;
}

.emg-body p {
  margin: 12rpx 0 0;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--ink2);
}

.emg-loc {
  margin: 20rpx 28rpx 0;
  background: var(--danger-soft);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #9c2f2d;
  line-height: 1.6;
}

.emg-route {
  margin: 16rpx 28rpx 0;
  padding-left: 0;
  list-style: none;
}

.emg-route li {
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.7;
  padding-left: 28rpx;
  position: relative;
}

.emg-route li::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #e2a5a3;
}

.emg-btns {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx 28rpx;
}

.btn.danger {
  background: linear-gradient(135deg, #ef5a58, #cf3432);
  color: #fff;
  box-shadow: 0 20rpx 40rpx -28rpx rgba(200, 50, 48, 0.9);
}

/* ---------- 输入区 ---------- */
.dock {
  flex: 0 0 auto;
  background: #fff;
  border-top: 2rpx solid rgba(15, 60, 70, 0.06);
  padding: 16rpx 24rpx 0;
  position: relative;
}

.quick {
  display: flex;
  gap: 14rpx;
  padding: 0 4rpx 16rpx;
  overflow-x: auto;
}

.quick button {
  flex: 0 0 auto;
  border: 2rpx solid var(--line);
  background: #fff;
  border-radius: 198rpx;
  font-family: inherit;
  font-size: 23rpx;
  color: var(--ink2);
  padding: 10rpx 20rpx;

  transition: 0.16s;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.quick button svg {
  width: 22rpx;
  height: 22rpx;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.inputbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 4rpx 20rpx;
}

.ibtn {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border: 0;
  background: transparent;
  border-radius: 50%;
  display: grid;
  place-items: center;

  color: #5c7a82;
  transition: 0.16s;
}

.ibtn.active {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.ibtn svg {
  width: 38rpx;
  height: 38rpx;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.field {
  flex: 1;
  height: 72rpx;
  border-radius: 198rpx;
  background: #f2f7f7;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.field input {
  border: 0;
  background: transparent;
  outline: none;
  width: 100%;
  font-family: inherit;
  font-size: 26rpx;
  color: var(--ink);
}

.field input::placeholder {
  color: #a9bdc2;
}

.send {
  width: 104rpx;
  height: 72rpx;
  flex: 0 0 104rpx;
  border: 0;
  border-radius: 198rpx;
  font-family: inherit;
  font-size: 25rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #17bbb0, #07818f);

  transition: 0.2s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.send:disabled {
  background: #d6e4e6;
  color: #fff;

  filter: none;
}

.homebar {
  height: 44rpx;
  display: grid;
  place-items: center;
  padding-bottom: 12rpx;
  background: #fff;
}

.homebar i {
  width: 252rpx;
  height: 9rpx;
  border-radius: 198rpx;
  background: #0e2a31;
  opacity: 0.85;
}

/* ---------- 就诊流程页 ---------- */
.detail-hero {
  background: linear-gradient(150deg, #0fa8a6, #0a7c90 72%);
  border-radius: 40rpx;
  padding: 32rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 36rpx 64rpx -44rpx rgba(7, 90, 110, 0.95);
  margin-top: 8rpx;
}

.detail-hero::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0) 70%);
}

.dh-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
}

.dh-dept {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.dh-type {
  margin-top: 8rpx;
  font-size: 23rpx;
  opacity: 0.85;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dh-type span {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
}

.dh-no {
  text-align: right;
  font-size: 22rpx;
  opacity: 0.85;
}

.dh-no b {
  display: block;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  opacity: 1;
}

.dh-meta {
  display: flex;
  gap: 36rpx;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.18);
  position: relative;
}

.dh-meta div {
  font-size: 22rpx;
  opacity: 0.82;
}

.dh-meta b {
  display: block;
  font-size: 27rpx;
  margin-top: 4rpx;
  opacity: 1;
  font-weight: 600;
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx 4rpx 24rpx;
}

.sec-title h3 {
  margin: 0;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.sec-title .line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, var(--line), rgba(232, 239, 240, 0));
}

.sec-title span {
  font-size: 22rpx;
  color: var(--muted);
}

.timeline {
  position: relative;
  padding-left: 64rpx;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 23rpx;
  top: 16rpx;
  bottom: 44rpx;
  width: 3rpx;
  background: linear-gradient(to bottom, #0ea5a5 0%, #a9ddd9 38%, #dcebec 100%);
}

.step {
  position: relative;
  padding: 0 0 36rpx;
}

.step .bullet {
  position: absolute;
  left: -64rpx;
  top: 2rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: grid;
  place-items: center;
  font-size: 22rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  background: #fff;
  border: 3rpx solid #dbe8e8;
  color: var(--muted);
  z-index: 1;
}

.step.done .bullet {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
}

.step.done .bullet svg {
  width: 24rpx;
  height: 24rpx;
  stroke: #fff;
  fill: none;
  stroke-width: 2.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.step.now .bullet {
  background: #fff;
  border-color: var(--brand);
  color: var(--brand-deep);
  box-shadow: 0 0 0 8rpx rgba(14, 165, 165, 0.14);
}

.step h4 {
  margin: 0;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.step h4 .pill {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 14rpx;
  border-radius: 198rpx;
  background: #f1f7f7;
  color: var(--muted);
}

.step.now h4 .pill {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.step p {
  margin: 6rpx 0 0;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--muted);
}

.step .where {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--brand-deep);
  background: #f2fafa;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}

.step .where svg {
  width: 20rpx;
  height: 20rpx;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
}

.tipcard {
  background: #fff9f4;
  border: 2rpx solid #fbe6d6;
  border-radius: 32rpx;
  padding: 26rpx 28rpx;
  margin-top: 12rpx;
}

.tipcard h5 {
  margin: 0 0 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #b4571f;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tipcard ul {
  margin: 0;
  padding-left: 30rpx;
  font-size: 23rpx;
  line-height: 1.85;
  color: #8a6247;
}

.detail-cta {
  flex: 0 0 auto;
  padding: 20rpx 32rpx 0;
  background: #fff;
  border-top: 2rpx solid rgba(15, 60, 70, 0.06);
}

.cta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.price {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.35;
}

.price b {
  display: block;
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.price b small {
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 2rpx;
}

.btn.disabled,
.btn:disabled {
  background: #e4ecec;
  color: #a8bcbe;
  box-shadow: none;

  filter: none;
}

/* ---------- 底部弹层 / 遮罩 / 提示 ---------- */
.mask {
  position: absolute;
  inset: 0;
  background: rgba(9, 32, 38, 0.42);

  z-index: 30;
  animation: fadeIn 0.22s ease both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 31;
  background: #fff;
  border-radius: 52rpx 52rpx 0 0;
  padding: 20rpx 32rpx 0;
  max-height: 88%;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -40rpx 100rpx -40rpx rgba(9, 45, 55, 0.4);
  animation: up 0.34s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes up {
  from {
    transform: translateY(120rpx);
    opacity: 0.4;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.grab {
  width: 76rpx;
  height: 8rpx;
  border-radius: 198rpx;
  background: #dfe9ea;
  margin: 4rpx auto 24rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sheet-head h3 {
  margin: 0;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.sheet-head p {
  margin: 6rpx 0 0;
  font-size: 23rpx;
  color: var(--muted);
}

.close {
  width: 52rpx;
  height: 52rpx;
  border: 0;
  border-radius: 50%;
  background: #f3f7f7;

  display: grid;
  place-items: center;
  color: #68858c;
  flex: 0 0 52rpx;
}

.close svg {
  width: 24rpx;
  height: 24rpx;
  stroke: currentColor;
  stroke-width: 2.2;
  stroke-linecap: round;
}

/* 转人工弹窗 */
.handoff-body {
  padding: 12rpx 0 8rpx;
}

.ho-phone {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #f6fafa;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.ho-phone .ico {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 26rpx;
  background: linear-gradient(150deg, #19bdb4, #07818e);
  display: grid;
  place-items: center;
}

.ho-phone .ico svg {
  width: 38rpx;
  height: 38rpx;
  stroke: #fff;
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.ho-phone .num {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
}

.ho-phone .lbl {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.ho-rows {
  margin-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.ho-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--line);
  font-size: 25rpx;
}

.ho-row span:first-child {
  color: var(--muted);
  flex: 0 0 auto;
}

.ho-row span:last-child {
  color: var(--ink);
  text-align: right;
}

.ho-tip {
  margin-top: 24rpx;
  background: #fff9f4;
  border: 2rpx solid #fbe6d6;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8a6247;
}

.sheet-foot {
  flex: 0 0 auto;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0 52rpx;
}

.sheet-foot .btn {
  padding: 24rpx 0;
  font-size: 28rpx;
  border-radius: 28rpx;
}

/* 附件选择面板 */
.attach-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 12rpx 0 8rpx;
}

.attach-item {
  border: 3rpx dashed #dbe8e8;
  background: #fbfefe;
  border-radius: 32rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;

  transition: 0.18s;
  font-family: inherit;
}

.attach-item .ai {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: var(--brand-soft);
  display: grid;
  place-items: center;
}

.attach-item .ai svg {
  width: 38rpx;
  height: 38rpx;
  stroke: var(--brand-deep);
  fill: none;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.attach-item b {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink2);
}

.attach-item small {
  font-size: 21rpx;
  color: var(--muted);
}

.attach-note {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
  margin: 20rpx 4rpx 0;
}

/* Toast */
.toast {
  position: absolute;
  left: 50%;
  bottom: 280rpx;
  transform: translateX(-50%);
  background: rgba(14, 42, 49, 0.9);
  color: #fff;
  font-size: 25rpx;
  padding: 18rpx 32rpx;
  border-radius: 198rpx;
  z-index: 60;
  white-space: nowrap;
  max-width: 82%;
  overflow: hidden;
  text-overflow: ellipsis;
  animation: toastIn 0.24s ease both;

}

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translate(-50%, 16rpx);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

/* 录音中 */
.recording {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  height: 72rpx;
  flex: 1;
  border-radius: 198rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 25rpx;
  font-weight: 500;
}

.recording .wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 28rpx;
}

.recording .wave i {
  width: 4rpx;
  border-radius: 4rpx;
  background: var(--brand);
  animation: wave 0.9s ease-in-out infinite;
}

.recording .wave i:nth-child(1) {
  height: 12rpx;
  animation-delay: 0s;
}
.recording .wave i:nth-child(2) {
  height: 24rpx;
  animation-delay: 0.1s;
}
.recording .wave i:nth-child(3) {
  height: 16rpx;
  animation-delay: 0.2s;
}
.recording .wave i:nth-child(4) {
  height: 28rpx;
  animation-delay: 0.3s;
}
.recording .wave i:nth-child(5) {
  height: 14rpx;
  animation-delay: 0.4s;
}

@keyframes wave {
  0%,
  100% {
    transform: scaleY(0.5);
  }
  50% {
    transform: scaleY(1);
  }
}

