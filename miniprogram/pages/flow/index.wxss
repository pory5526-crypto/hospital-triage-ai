/* 就诊流程页 */

.flow-body {
  padding-bottom: 340rpx;
}

/* ---------- 科室信息卡 ---------- */
.dh-left {
  min-width: 0;
  flex: 1;
}

.dh-type {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.dh-tag {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 23rpx;
  color: #fff;
}

.dh-doc {
  font-size: 23rpx;
  opacity: 0.85;
  color: #fff;
}

.dh-no-k {
  font-size: 22rpx;
  opacity: 0.85;
  color: #fff;
}

.dh-no-v {
  display: block;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 600;
  color: #fff;
}

.dh-meta-item {
  font-size: 22rpx;
  opacity: 0.82;
  color: #fff;
  flex: 1;
  min-width: 0;
}

.dh-meta-item .k {
  display: block;
  font-size: 22rpx;
  opacity: 0.82;
}

.dh-meta-item .v {
  display: block;
  font-size: 27rpx;
  margin-top: 4rpx;
  opacity: 1;
  font-weight: 600;
  color: #fff;
}

/* ---------- 小标题 ---------- */
.sec-t {
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #0e2a31;
}

.sec-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, #e8eff0, rgba(232, 239, 240, 0));
}

.sec-s {
  font-size: 22rpx;
  color: #8ca2aa;
}

/* ---------- 时间线 ---------- */
.step-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.step-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #0e2a31;
}

.step-pill {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 14rpx;
  border-radius: 198rpx;
  background: #f1f7f7;
  color: #8ca2aa;
}

.now-pill {
  background: #e5f7f6;
  color: #05787f;
}

.step-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8ca2aa;
}

.step-where {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #05787f;
  background: #f2fafa;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}

.pin {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 3rpx solid #05787f;
}

.bullet {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8ca2aa;
}

.step.done .bullet .check {
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

/* ---------- 到院前准备 ---------- */
.tip-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #b4571f;
}

.tip-i {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid #b4571f;
  font-size: 16rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b4571f;
}

.tip-item {
  font-size: 23rpx;
  line-height: 1.85;
  color: #8a6247;
}

/* ---------- 底部挂号栏 ---------- */
.detail-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding-bottom: env(safe-area-inset-bottom);
}

.cta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.price-k {
  display: block;
  font-size: 22rpx;
  color: #8ca2aa;
}

.price-v {
  display: block;
  font-size: 32rpx;
  color: #0e2a31;
  font-weight: 600;
}
