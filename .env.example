# ============================================================
#  医院智能导诊 AI 客服 · 环境变量
#  复制本文件为 backend/.env 后填写；不填也能跑（降级为规则模式）
# ============================================================

# ---------- 大模型（OpenAI 兼容协议，三选一）----------
# ① DeepSeek（推荐，便宜且中文好）
HOSPITAL_LLM_BASE_URL=https://api.deepseek.com/v1
HOSPITAL_LLM_API_KEY=
HOSPITAL_LLM_MODEL=deepseek-chat

# ② 通义千问
# HOSPITAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HOSPITAL_LLM_API_KEY=sk-xxxxxxxx
# HOSPITAL_LLM_MODEL=qwen-plus

# ③ 智谱 GLM
# HOSPITAL_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# HOSPITAL_LLM_API_KEY=xxxxxxxx
# HOSPITAL_LLM_MODEL=glm-4-flash

# ④ 千问 AI 平台（platform.qianwenai.com）
# 注意：base_url 里的域名是 maas.qianwenaiapi.com，中间有 api，容易漏
# HOSPITAL_LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# HOSPITAL_LLM_API_KEY=sk-ws-xxxxxxxx
# HOSPITAL_LLM_MODEL=qwen3.8-flash
# Qwen 思考型模型可关掉思考换速度（首字 ~1s → ~0.7s），留空则不下发该参数
HOSPITAL_LLM_ENABLE_THINKING=false

# 语音识别（小程序端语音输入用，走同一个 Key）
HOSPITAL_ASR_MODEL=qwen-audio-3.1-asr-flash

# ⑤ 本地 Ollama（零成本调试，需先 ollama pull qwen2.5:7b）
# HOSPITAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# HOSPITAL_LLM_API_KEY=ollama
# HOSPITAL_LLM_MODEL=qwen2.5:7b

HOSPITAL_LLM_TIMEOUT=25
HOSPITAL_LLM_MAX_TOKENS=800
HOSPITAL_LLM_TEMPERATURE=0.3
HOSPITAL_ENABLE_TOOL_CALLING=true

# ---------- RAG ----------
HOSPITAL_RAG_TOP_K=4
HOSPITAL_RAG_MIN_SCORE=0.18

# ---------- 医院信息（改这里就能换一家医院）----------
HOSPITAL_NAME=协和医院
HOSPITAL_TRIAGE_PHONE=010-69156114
HOSPITAL_EMERGENCY_PHONE=010-69155120
HOSPITAL_SERVICE_HOURS=工作日 7:30–17:00 · 周六 8:00–12:00
HOSPITAL_AFTER_HOURS_TIP=非人工服务时间请前往门诊楼 1F 导诊台，急诊请直接到急诊楼 1F。

# ---------- 上传 ----------
HOSPITAL_MAX_UPLOAD_MB=10

# ---------- 特性开关（V1 全关；V2 上线对应功能后打开）----------
HOSPITAL_FEATURE_DEPT_SHEET=false
HOSPITAL_FEATURE_APPOINTMENT=false
HOSPITAL_FEATURE_REPORT_READ=false
HOSPITAL_FEATURE_REMINDER=false

# ---------- 跨域（生产环境建议写死域名）----------
HOSPITAL_CORS_ORIGINS=*
